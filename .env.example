# Required Neon Postgres connection string. Add this as a secret environment
# variable in Netlify; never expose it through a NEXT_PUBLIC_ variable.
DATABASE_URL=

# Email that receives administrator permissions for dataset imports.
ADMIN_EMAIL=

# Web client ID for Google Identity Services (not a secret).
GOOGLE_CLIENT_ID=

# Resend API key and sender for password-recovery emails. The sender must use
# a domain verified in Resend; never expose the API key in a public variable.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
